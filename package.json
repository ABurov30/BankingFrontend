{
  "name": "buro-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/shared/api/schema.ts && prettier --write src/shared/api/schema.ts",
    "dev": "vite",
    "dev:domain": "VITE_DEV_HOST=buro-bank.ru VITE_DEV_PROXY=true vite",
    "dev:cert": "mkdir -p .certs && openssl req -x509 -newkey rsa:2048 -nodes -keyout .certs/buro-bank.ru.key -out .certs/buro-bank.ru.crt -days 365 -subj \"/CN=buro-bank.ru\" -addext \"subjectAltName=DNS:buro-bank.ru\"",
    "dev:nginx": "docker run --rm --name buro-frontend-dev-nginx -p 443:443 -v \"$PWD/nginx.dev.conf:/etc/nginx/conf.d/default.conf:ro\" -v \"$PWD/.certs:/etc/nginx/certs:ro\" nginx:1.27-alpine",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "docker:build": "docker build -t buro-frontend .",
    "docker:run": "docker run --rm --name buro-frontend -p 5173:80 buro-frontend",
    "docker:up": "npm run docker:build && npm run docker:run"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "@reduxjs/toolkit": "2.12.0",
    "@stomp/stompjs": "7.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.62.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
